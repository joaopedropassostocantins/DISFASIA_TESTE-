    "def parse_iap_response(text):\n",
    "    # Captura apenas o que vem depois de \"Resposta:\" \n",
    "    # Usamos uma estratégia de busca reversa para pegar os últimos valores se houver repetição do prompt\n",
    "    extracted = re.findall(r'Resposta:\\s*(\\d+(?:\\.\\d+)?)', text)\n",
    "    \n",
    "    # Se o modelo repetiu o prompt, pegamos apenas as últimas 12 ocorrências (as respostas reais)\n",
    "    if len(extracted) > 12:\n",
    "        extracted = extracted[-12:]\n",
    "        \n",
    "    vec = [float(n) for n in extracted]\n",
    "    if len(vec) < 12: vec = vec + [5.0] * (12 - len(vec))\n",
    "    vec = np.array(vec[:12])\n",
    "    return np.clip(vec, 0, 10)\n"
   ]
