    "@kbench.task(\n",
    "    name=\"ATMS-IAP Topological Metacognition\",\n",
    "    description=\"Avaliação de Metacognição Topológica baseada no Voo do Pássaro.\"\n",
    ")\n",
    "def evaluate_atms_iap(llm) -> float:\n",
    "    \"\"\"\n",
    "    Realiza a prova de intuição semântica no LLM e calcula \n",
    "    a convergência topológica com o Gabarito Estrela humano.\n",
    "    \"\"\"\n",
    "    prompt = \"\"\"\n",
    "    Você é uma pessoa comum respondendo um formulário científico com base apenas na sua própria intuição humana...\n",
    "    IMAGINE ESTA SITUAÇÃO: Uma criança chorando com um corte no joelho e um caco de vidro ao lado.\n",
    "    Responda em formato de lista numerada (1 a 12) seguindo o modelo: [Número]. [Eixo]: Resposta: [valor]\n",
    "    \"\"\"\n",
    "    \n",
    "    # Execução da inferência isolada\n",
    "    with kbench.chats.new(\"atms_iap_benchmark\"):\n",
    "        response = llm.prompt(prompt)\n",
    "    \n",
    "    # Cálculo da Metacognição via Topologia\n",
    "    model_vector = parse_iap_response(str(response))\n",
    "    dist = calculate_wasserstein(GABARITO_MEDIANA, model_vector)\n",
    "    \n",
    "    # O Score é a convergência: 1.0 = Humano Perfeito | 0.0 = Divergência Total\n",
    "    score = 1.0 / (1.0 + dist)\n",
    "    \n",
    "    print(f\"Distância Topológica: {dist:.4f}\")\n",
    "    print(f\"Score de Metacognição (ATMS-IAP): {score:.2%}\")\n",
    "    \n",
    "    return float(score)\n"
   ]
