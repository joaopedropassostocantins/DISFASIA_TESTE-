    "def parse_iap_response(text):\n",
    "    # Regex para extrair números [x] ou após 'Resposta:'\n",
    "    numbers = re.findall(r'\\[\\s*(\\d+(?:\\.\\d+)?)\\s*\\]|Resposta:\\s*(\\d+(?:\\.\\d+)?)', text)\n",
    "    extracted = [float(n[0] or n[1]) for n in numbers]\n",
    "    if len(extracted) < 12:\n",
    "        extracted = [float(n) for n in re.findall(r'\\d+(?:\\.\\d+)?', text)][:12]\n",
    "    vec = np.array(extracted[:12])\n",
    "    if len(vec) < 12:\n",
    "        vec = np.pad(vec, (0, 12 - len(vec)), mode='constant', constant_values=5.0)\n",
    "    return np.clip(vec, 0, 10)\n"
   ]
