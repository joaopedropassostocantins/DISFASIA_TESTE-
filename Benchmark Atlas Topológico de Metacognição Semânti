    "def compute_h0_diagram(vector):\n",
    "    v = np.array(vector)\n",
    "    births = np.sort(v)[::-1] \n",
    "    dgm = [[births[i], births[i+1] if i < len(births)-1 else 0] for i in range(len(births))]\n",
    "    return np.array(dgm)\n",
    "\n",
    "def calculate_wasserstein(v1, v2):\n",
    "    d1 = compute_h0_diagram(v1); d2 = compute_h0_diagram(v2)\n",
    "    n = len(d1); cost = np.zeros((n, n))\n",
    "    for i in range(n):\n",
    "        for j in range(n):\n",
    "            cost[i,j] = np.sum(np.abs(d1[i] - d2[j]))\n",
    "    row, col = linear_sum_assignment(cost)\n",
    "    return cost[row, col].sum() / n\n"
   ]
