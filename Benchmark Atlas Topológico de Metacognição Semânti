    "# =============================================================================\n",
    "# VISUALIZAÇÃO MASTER (VERSÃO FINAL): Atlas Topológico Gemini vs Humano\n",
    "# =============================================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from sklearn.manifold import MDS\n",
    "\n",
    "# 1. DADOS REAIS DO BENCHMARK (Recalibrados)\n",
    "EIXOS = [\"Concre.\", \"Emoção\", \"Ação\", \"Social\", \"Urgên.\", \"Tempo\", \"Espaço\", \"Saúde\", \"Comuni.\", \"Cognit.\", \"Nec.Bás.\", \"CAA\"]\n",
    "GABARITO_HUMANO = [10.0, 9.5, 8.5, 5.0, 8.0, 8.5, 8.0, 10.0, 9.5, 1.5, 9.5, 10.0]\n",
    "GEMINI_FLASH    = [10.0, 10.0, 8.0, 9.0, 10.0, 10.0, 10.0, 10.0, 9.0, 7.0, 9.0, 10.0]\n",
    "\n",
    "# Prepara dados para o Atlas MDS\n",
    "noise = np.random.normal(0, 0.5, (15, 12))\n",
    "cloud = np.clip(np.array(GABARITO_HUMANO) + noise, 0, 10)\n",
    "data = np.vstack([GABARITO_HUMANO, GEMINI_FLASH, cloud])\n",
    "\n",
    "# 2. MOTOR TOPOLÓGICO MDS (Ajustado para Versão Kaggle)\n",
    "mds = MDS(\n",
    "    n_components=2, \n",
    "    random_state=42, \n",
    "    normalized_stress='auto', \n",
    "    n_init=1, \n",
    "    init='classical_mds'\n",
    ")\n",
    "coords = mds.fit_transform(data) # GERANDO AS COORDENADAS\n",
    "\n",
    "# 3. CRIAÇÃO DO DASHBOARD VISUAL\n",
    "fig = plt.figure(figsize=(16, 7), facecolor='#F0F2F6')\n",
    "\n",
    "# --- RADAR COMPARATIVO ---\n",
    "ax1 = fig.add_subplot(1, 2, 1, polar=True)\n",
    "angles = np.linspace(0, 2*np.pi, len(EIXOS), endpoint=False).tolist()\n",
    "angles += angles[:1]\n",
    "v_h = GABARITO_HUMANO + [GABARITO_HUMANO[0]]\n",
    "v_g = GEMINI_FLASH + [GEMINI_FLASH[0]]\n",
    "\n",
    "ax1.fill(angles, v_h, color='gold', alpha=0.3, label='Mediana Humana (Centro)', linewidth=2)\n",
    "ax1.fill(angles, v_g, color='#00d1ff', alpha=0.4, label='Gemini 2.5 Flash', linewidth=3)\n",
    "ax1.set_xticks(angles[:-1])\n",
    "ax1.set_xticklabels(EIXOS, fontsize=8, fontweight='bold')\n",
    "ax1.set_title(\"GEOMETRIA SEMÂNTICA (RADAR)\", size=12, pad=20, fontweight='bold')\n",
    "ax1.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1))\n",
    "\n",
    "# --- ATLAS MDS ---\n",
    "ax2 = fig.add_subplot(1, 2, 2)\n",
    "ax2.scatter(coords[2:, 0], coords[2:, 1], color='gray', alpha=0.15, label='Variância Humana')\n",
    "ax2.scatter(coords[0, 0], coords[0, 1], s=400, color='gold', marker='*', edgecolors='black', label='ALVO HUMANO', zorder=5)\n",
    "ax2.scatter(coords[1, 0], coords[1, 1], s=250, color='#00d1ff', marker='o', edgecolors='black', label='GEMINI FLASH', zorder=10)\n",
    "\n",
    "# Linha de Gap Topológico\n",
    "ax2.plot([coords[0, 0], coords[1, 0]], [coords[0, 1], coords[1, 1]], color='red', linestyle=':', alpha=0.6)\n",
    "\n",
    "ax2.set_title(\"ATLAS TOPOLÓGICO (MDS 2D)\", size=12, fontweight='bold')\n",
    "ax2.grid(True, linestyle='--', alpha=0.3)\n",
    "ax2.legend(fontsize='x-small')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 4. DIAGNÓSTICO FINAL\n",
    "dist = np.linalg.norm(np.array(GABARITO_HUMANO) - np.array(GEMINI_FLASH))\n",
    "print(f\"ANÁLISE DE CAMPO:\")\n",
    "print(f\"- Distância Euclidiana de Erro: {dist:.2f}\")\n",
    "print(f\"- O desalinhamento é visível nos picos de 'Social' e 'Cognitivo'.\")\n"
   ]
