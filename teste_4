de números\n    kbench.assertions.assert_in(\"[\", response)\n    kbench.assertions.assert_in(\"]\", response)\n\n    # C. Julgamento Avançado (IA Judge)\n    # Aqui verificamos se o modelo \"pensa\" como o seu Algoritmo JP\n    assessment = kbench.assertions.assess_response_with_judge(\n        response_text=response,\n        judge_llm=kbench.judge_llm,\n        criteria=[\n            \"A nota de Emocionalidade deve ser alta (entre 8 e 10) para o conceito 'Frustrado'.\",\n            \"A nota de Concretude deve ser baixa (entre 0 e 3) para o conceito 'Frustrado'.\"\n        ]\n    )\n\n    for result in assessment.results:\n        kbench.assertions.assert_true(\n            result.passed,\n            expectation=f\"Critério '{result.criterion}' falhou: {result.reason}\"\n        )\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}